{
  "name": "@wasmpeg/cpu",
  "version": "1.0.1",
  "description": "WebGPU-accelerated FFmpeg compiled to WebAssembly (CPU-only build, no WebGPU binary — smaller download for Node/server use)",
  "license": "LGPL-2.1-or-later",
  "type": "module",
  "main": "src/js/index.js",
  "types": "./src/js/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/js/index.d.ts",
      "default": "./src/js/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/js/",
    "dist/cpu.js",
    "dist/cpu.wasm",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/test.mjs",
    "build": "bash scripts/build.sh",
    "compat": "node tests/compat.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wasmpeg/wasmpeg.git"
  },
  "keywords": [
    "ffmpeg",
    "wasm",
    "webgpu",
    "video",
    "audio",
    "decode",
    "encode"
  ],
  "sideEffects": false
}
